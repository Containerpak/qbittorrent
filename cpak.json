{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "qBittorrent",
  "description": "Download and share files with BitTorrent.",
  "version": "5.1.4",
  "image": "ghcr.io/containerpak/qbittorrent@sha256:f14d88fce097cb16404da044304f7b2c408d806c4280cb8940cbb64230b3453c",
  "binaries": [
    "/usr/bin/qbittorrent"
  ],
  "desktop_entries": [
    "/usr/share/applications/org.qbittorrent.qBittorrent.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
